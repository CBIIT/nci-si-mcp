   "definitions": [
    {
     "definition": "A fusion gene that results from a chromosomal inversion inv(22)(q12q12) which fuses the first eight exons of the EWSR1 gene with the PATZ1 gene. This rearrangement is associated with Ewing tumor/peripheral primitive neuroectodermal tumor.",
     "code": "P97",
     "type": "DEFINITION",
