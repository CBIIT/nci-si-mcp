   ],
   "definitions": [
    {
     "definition": "Core library of terms associated with pediatrics, representing information related to child health and development from pre-birth through 21 years of age; contributed by the National Institute of Child Health and Human Development.",
     "code": "P97",
     "type": "DEFINITION",
     "source": "NCI"
    }
   ],
   "properties": [
    {
     "code": "P322",
     "type": "Contributing_Source",
